# Copy this file to .env.local and fill in your Supabase project values.
# Project settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is only used by server-side scheduled tasks (e.g. overdue
# invoice flagging via a route handler). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
